import Geodesia

open Geodesia

/-! # Geodesia demo

Everything below is built from `Smooth2` combinators, so the derivatives are
exact — no finite differences.  Run with `lake exe geodesia`.
-/

/-- `z = 0.3 (x² + y²)`, differentiated symbolically. -/
def paraboloid : Smooth2 :=
  Smooth2.smul 0.3
    (Smooth2.add (Smooth2.mul Smooth2.coordX Smooth2.coordX)
      (Smooth2.mul Smooth2.coordY Smooth2.coordY))

/-- The height-field lift `(x, y) ↦ (x, y, 0.3(x² + y²))`. -/
def paraboloidSurface : Surface := Surface.ofHeight paraboloid

/-- Unit sphere `(θ, φ) ↦ (sin θ cos φ, sin θ sin φ, cos θ)`, with exact
partials generated by the `Smooth2.sin`/`cos` chain rule. -/
def sphere : Surface where
  sx := Smooth2.mul (Smooth2.sin Smooth2.coordX) (Smooth2.cos Smooth2.coordY)
  sy := Smooth2.mul (Smooth2.sin Smooth2.coordX) (Smooth2.sin Smooth2.coordY)
  sz := Smooth2.cos Smooth2.coordX

def main : IO Unit := do
  let x := 1.0
  let y := 0.0
  let s := paraboloidSurface
  IO.println "Geodesia — exact differential geometry (no finite differences)"
  IO.println s!"paraboloid z = 0.3(x² + y²) at (x, y) = ({x}, {y})"
  IO.println s!"  Φ            = {Surface.point s x y}"
  let I := Surface.metricI s x y
  IO.println s!"  I            = [[{I.a}, {I.b}], [{I.b}, {I.c}]]"
  let G := Surface.christoffel s x y
  IO.println s!"  Γ¹₁₁, Γ¹₁₂, Γ¹₂₂ = {G 0 0 0}, {G 0 0 1}, {G 0 1 1}"
  IO.println s!"  Γ²₁₁, Γ²₁₂, Γ²₂₂ = {G 1 0 0}, {G 1 0 1}, {G 1 1 1}"
  let k := Surface.gaussK s x y
  let h := Surface.meanH s x y
  let (kmin, kmax) := Surface.principalK s x y
  IO.println s!"  K, H          = {k}, {h}"
  IO.println s!"  κ_min, κ_max  = {kmin}, {kmax}"

  let st0 : GeoState := ⟨x, y, 1.0, 0.0⟩
  let stE := Geodesic.eulerIntegrate s (1.0 / 100) 100 st0
  let stR := Geodesic.integrate s (1.0 / 100) 100 st0
  IO.println "geodesic from (1, 0) with parameter velocity (1, 0), s ∈ [0, 1]"
  IO.println s!"  RK4 endpoint  = {Surface.point s stR.u stR.v}"
  IO.println s!"  Euler endpoint= {Surface.point s stE.u stE.v}"
  IO.println s!"  E(0)          = {Geodesic.energy s st0}"
  IO.println s!"  E RK4, Euler  = {Geodesic.energy s stR}, {Geodesic.energy s stE}"

  IO.println "the two accelerations at the start state"
  IO.println s!"  Christoffel   = {Geodesic.accelChristoffel s st0}"
  IO.println s!"  vector        = {Geodesic.accelVector s st0}"

  IO.println "the two right-hand sides at the same state"
  IO.println s!"  rhs       = {Geodesic.rhs s st0}"
  IO.println s!"  rhsVector = {Geodesic.rhsVector s st0}"

  let stE1 := Geodesic.eulerStep s (1.0 / 10) st0
  let stR1 := Geodesic.rk4Step s (1.0 / 10) st0
  IO.println "one step of size 0.1 from the same state"
  IO.println s!"  Euler         = {stE1}"
  IO.println s!"  RK4           = {stR1}"

  let hit := Geodesic.shoot s x y 0.6 1.0 100
  IO.println s!"  shoot(angle=0.6, length=1) = {hit}"

  let θ := 1.0
  let φ := 0.2
  IO.println s!"unit sphere at (θ, φ) = ({θ}, {φ})"
  IO.println s!"  K (should be 1) = {Surface.gaussK sphere θ φ}"
